// conf/pbs.config
// Configuration for PBS Pro cluster execution
// 
// IMPORTANT: Update the following parameters for your specific cluster:
// - params.pbs_project: Your PBS project ID
// - params.pbs_storage: Storage paths required by your cluster
// - process.queue: Queue names for your cluster
// - process.scratch: Scratch directory path

params {
    // PBS-specific parameters - MUST BE CONFIGURED FOR YOUR CLUSTER
    pbs_project = 'ei56'    // e.g., 'ab12' - REQUIRED for PBS submission
    pbs_storage = 'scratch/ei56+gdata/ei56+scratch/fy54+gdata/fy54'    // e.g., 'scratch/ab12+gdata/ab12' - REQUIRED for PBS
}

process {
    executor = 'pbspro'
    
    // Cluster-specific settings - UPDATE THESE FOR YOUR ENVIRONMENT
    project  = params.pbs_project  // Your PBS project code
    storage  = params.pbs_storage  // Storage paths required by your cluster
    
    // Module loading (if using environment modules)
    module       = 'singularity'
    beforeScript = 'module load singularity'
    
    // Scratch directory for temporary files
    scratch = true
    // scratch = '/scratch/your_project/your_username/tmp'  // Uncomment and set if needed
    
    // Queue selection based on memory requirements
    // ADJUST THESE THRESHOLDS AND QUEUE NAMES FOR YOUR CLUSTER
    queue = { 
        task.memory < 128.GB ? 'normal' : 
        (task.memory >= 128.GB && task.memory <= 190.GB ? 'normalbw' : 
        (task.memory > 190.GB && task.memory <= 1020.GB ? 'hugemem' : 'hugemembw')) 
    }
    
    cache = 'lenient'
    
    // Process-specific resource allocations
    withName: 'PREPARE_GENE_COORDS' {
        cpus   = 2
        memory = '9GB'
        time   = '4h'
        disk   = '5GB'
    }

    // Cepo with computePvalue = 100 runs 100 permutations, so it needs far more
    // wall time than the label default.
    withName: 'RUN_CEPO' {
        cpus   = 7
        memory = '256GB'
        time   = '24h'
        disk   = '100GB'
    }

    withName: 'NORMALIZE_H5AD' {
        cpus   = 4
        memory = '256GB'
        time   = '6h'
        disk   = '100GB'
    }

    withName: 'RUN_CELLEX' {
        cpus   = 7
        memory = '256GB'
        time   = '12h'
        disk   = '100GB'
    }

    withName: 'RUN_SEISMIC' {
        cpus   = 4
        memory = '256GB'
        time   = '8h'
        disk   = '100GB'
    }

    // pybedtools writes many large temporary files during the bimbed intersect.
    withName: 'MAKE_ANNOT|MAKE_ANNOT_ALL_GENES' {
        cpus   = 2
        memory = '32GB'
        time   = '8h'
        disk   = '150GB'
    }

    withName: 'RUN_LDSC_CTS' {
        cpus   = 2
        memory = '64GB'
        time   = '12h'
        disk   = '50GB'
    }

    withName: 'CREATE_MAGMA_GENESET' {
        cpus   = 2
        memory = '9GB'
        time   = '4h'
        disk   = '5GB'
    }

    withName: 'RUN_MAGMA' {
        cpus   = 7
        memory = '32GB'
        time   = '4h'
        disk   = '16GB'
    }
    
    // Resource labels for flexibility
    withLabel: low_mem {
        cpus   = 2
        memory = '9GB'
        time   = '4h'
        disk   = '5GB'
    }
    
    withLabel: medium_mem {
        cpus   = 7
        memory = '32GB'
        time   = '4h'
        disk   = '16GB'
    }
    
    withLabel: high_mem {
        cpus   = 7
        memory = '256GB'
        time   = '4h'
        disk   = '100GB'
    }
    
}
