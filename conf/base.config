// conf/base.config
// Base configuration for standard execution

params {
    // This file can be used to override default parameters
    // when using '-c conf/base.config' or for profile-specific settings
}

process {
    // Default resources - can be overridden by profiles or command line
    cpus   = 1
    memory = 6.GB
    time   = '4h'

    errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139] ? 'retry' : 'finish' }
    maxRetries    = 2
}

// Container configuration
singularity {
    enabled    = true
    autoMounts = true
}
