// conf/test.config
// Small demo run: 8 fetal bone marrow cell types x 300 cells (Jardine et al. 2021) against
// the Jansen et al. 2019 Alzheimer's disease GWAS. Combine with an executor profile, e.g.
//   nextflow run main.nf -profile pbs,test
// Profiles apply in order, so the resource overrides below replace the 256 GB defaults in
// conf/pbs.config. See the Demo section of the README for building the demo inputs.

params {
    h5ad_input       = 'data/demo/fbm_demo.h5ad'
    gwas_sumstats    = 'data/demo/AD_sumstats_Jansenetal_2019sept.txt.gz'
    gwas_name        = 'AD_Jansen2019'
    gwas_sample_size = 455258
    genome_build     = 'hg19'
    cell_type_col    = 'cell.labels'
    scdrs_cov_file   = null
    outdir           = 'results/demo'
}

// Only the expression-bound steps shrink with the cell count; the GWAS-bound steps
// (mBAT-combo, LD scores, LDSC) keep their usual allocations. The selectors match
// conf/pbs.config's exactly, so these settings override those blocks.
process {
    withName: 'NORMALIZE_H5AD' {
        cpus   = 2
        memory = '16GB'
        time   = '2h'
    }
    withName: 'RUN_CEPO' {
        cpus   = 2
        memory = '16GB'
        time   = '2h'
    }
    withName: 'RUN_CELLEX' {
        cpus   = 2
        memory = '16GB'
        time   = '2h'
    }
    withName: 'RUN_SEISMIC' {
        cpus   = 2
        memory = '16GB'
        time   = '2h'
    }
    withLabel: high_mem {
        cpus   = 2
        memory = '16GB'
        time   = '2h'
    }
}
