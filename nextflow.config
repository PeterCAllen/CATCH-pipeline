// nextflow.config

// =====================================================
// Default Parameters
// =====================================================
params {
    // Input/Output - REQUIRED: Must be specified by user
    h5ad_input        = 'data/singlecell/Human_fetal_BM10x_preprocessed.h5ad'
    gwas_sumstats     = 'data/gwas/AD_sumstats_Jansenetal_2019sept.txt.gz'
    gwas_name         = 'AD_Jansen2019'  // Short name for GWAS 
    outdir            = 'results/Human_fetal_BM10x/AD_Jansen2019'  // Recommended format: results/<single-cell-object>/<gwas-name>

    // Genome Build - CRITICAL: Must match GWAS genome build
    genome_build      = 'hg19'  // Options: hg19, GRCh37, hg38, GRCh38
    gwas_sample_size  = 381761  // Total N for GWAS (required for MAGMA)
    
    // Single-cell parameters
    cell_type_col     = 'cell.labels'  // Column name in h5ad.obs with cell type annotations
    
    // Gene coordinates
    gene_matrix       = 'data/reference/geneMatrix.tsv.gz'  // Path to geneMatrix.tsv.gz
    
    // Reference data paths - ALWAYS use hg19/GRCh37
    // (Gene coordinates are automatically converted from hg38 when needed)
    // Base reference directory - Using collaborators' exact reference files
    ref_base_dir = 'data/reference/LDSC_relevant_for_Peter'
    
    // hg19/GRCh37 references (used for MAGMA, LDSC, and scDRS mBAT)
    ref_hg19_plink_dir        = "${ref_base_dir}/1000G_EUR_Phase3_plink"
    ref_hg19_plink_prefix     = "${ref_hg19_plink_dir}/1000G.EUR.QC"           // Per-chromosome: 1000G.EUR.QC.{1-22}.{bed,bim,fam} (for LDSC)
    ref_hg19_plink_combined   = "${ref_hg19_plink_dir}/1000G.EUR.QC.CHR_1_22"  // Combined all chr: 1000G.EUR.QC.CHR_1_22.{bed,bim,fam} (for MAGMA)
    ref_hg19_bim_file         = "${ref_hg19_plink_dir}/1000G.EUR.QC.CHR_1_22.bim"
    ref_hg19_baseline      = "${ref_base_dir}/baseline_v1.1_thin_annot/baseline."
    ref_hg19_weights       = "${ref_base_dir}/1000G_Phase3_weights_hm3_no_MHC/weights.hm3_noMHC."
    ref_hg19_hapmap3       = "data/reference/eur_w_ld_chr/hg19/hm3_no_MHC.list.txt"  // One-column rsID list required by LDSC --print-snps
    ref_hg19_gene_coords   = "${ref_base_dir}/gene_coordinates.GRCh37.ensembl_v91.txt"
    ref_hg19_print_snps    = "${ref_base_dir}/print_snps.txt"
    ref_hg19_frq_dir       = "${ref_base_dir}/1000G_Phase3_frq"
    
    // For backward compatibility (but always points to hg19)
    ref_1000g_prefix = params.ref_hg19_plink_prefix
    
    // MAGMA options
    magma_bin         = 'resources/magma'
    run_magma         = true
    magma_window_kb   = 10
    magma_top_pct     = 0.1
    
    // LDSC options
    run_ldsc           = true
    ldsc_window_kb     = 100
    ldsc_ld_wind_cm    = 1
    ldsc_overlap_annot = true
    ldsc_thin_annot    = true
    
    // scDRS options
    run_scdrs              = true
    scdrs_mbat_window_kb   = 10        // Window size in kb for mBAT gene-based test (MATCHES COLLABORATORS' 10KB)
    scdrs_top_genes        = 1000      // Top genes to include in gene set
    scdrs_n_ctrl           = 1000      // Number of control gene sets for scDRS
    
    // scDRS data processing flags - IMPORTANT: Must be strings "True" or "False"
    // Collaborators consistently use True for both parameters
    // If your h5ad is already filtered/QC'd, set filter_data="False"
    // If your h5ad has raw counts, set raw_count="True", if log-normalized set "False"
    scdrs_filter_data      = "False"    // Filter genes/cells ("True"/"False") - MATCHES COLLABORATORS
    scdrs_raw_count        = "True"    // Expect raw counts ("True"/"False") - MATCHES COLLABORATORS
    
    // scDRS covariate file (optional)
    // TSV file with columns: SAMPLE_ID, N_GENE, SEX, AGE
    // Used to control for technical and biological covariates in scDRS analysis
    scdrs_cov_file         = "data/singlecell/Human_fetal_BM10x_covariates.txt"      // Path to covariate file (optional)
    
    // Help
    help              = false
}

// Environment variables
env {
    SINGULARITY_CACHEDIR="$HOME/.singularity"
    OMP_NUM_THREADS = 1
    NUMBA_CACHE_DIR = "/tmp"
    OPENBLAS_NUM_THREADS = 1
    PYTHONNOUSERSITE     = 1
}

// Process defaults
process {
    cpus          = 1
    memory        = 6.GB
    time          = '4h'
    errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139] ? 'retry' : 'finish' }
    maxRetries    = 2
    cache         = 'lenient'
}

// Define named profiles for different execution environments
profiles {
    standard {
        // Profile for running locally with Singularity
        process.executor     = 'local'
        singularity.enabled  = true
        singularity.autoMounts = true
    }

    pbs {
        // Profile for PBS cluster execution
        includeConfig 'conf/pbs.config'
    }
    
    slurm {
        // Profile for SLURM cluster execution
        includeConfig 'conf/slurm.config'
    }
    
    // Add your custom profiles here as needed
}

// Container engine configuration
singularity {
    enabled    = true
    autoMounts = true
    cacheDir   = "${env.SINGULARITY_CACHEDIR ?: '\$HOME/.singularity'}"
}

// Enable DSL2
nextflow.enable.dsl = 2

// Manifest
manifest {
    name            = 'CATCHY Pipeline'
    author          = ' '
    homePage        = ' '
    description     = 'Single-cell RNA-seq and GWAS integration pipeline with LDSC, MAGMA and scDRS'
    mainScript      = 'main.nf'
    nextflowVersion = '>=21.04.0'
    version         = '1.0.0'
}

// Function to print help
def helpMessage() {
    log.info"""
    =====================================================
     ${manifest.name} v${manifest.version}
    =====================================================
    Usage:
      nextflow run main.nf --h5ad_input <file> --gwas_sumstats <file> --genome_build <hg19|hg38> --gwas_sample_size <N> [options]

    Required Arguments:
      --h5ad_input PATH          Path to input h5ad file
      --gwas_sumstats PATH       Path to GWAS summary statistics (gzipped)
      --genome_build STR         Genome build (hg19/GRCh37 or hg38/GRCh38)
      --gwas_sample_size INT     Total sample size for GWAS study
      --gene_matrix PATH         Path to geneMatrix.tsv.gz file

    Optional Arguments:
      --cell_type_col STR        Column in h5ad.obs with cell types [${params.cell_type_col}]
      --outdir PATH              Output directory [${params.outdir}]
      --ldsc_window_kb INT       Window size (kb) for LDSC [${params.ldsc_window_kb}]
      --magma_window_kb INT      Window size (kb) for MAGMA [${params.magma_window_kb}]
      --run_ldsc BOOL            Run LDSC analysis [${params.run_ldsc}]
      --run_magma BOOL           Run MAGMA analysis [${params.run_magma}]
      --run_scdrs BOOL           Run scDRS analysis [${params.run_scdrs}]
      
    scDRS Options (when --run_scdrs true):
      --scdrs_mbat_window_kb INT mBAT window size in kb [${params.scdrs_mbat_window_kb}]
      --scdrs_top_genes INT      Top genes for gene set [${params.scdrs_top_genes}]
      --scdrs_n_ctrl INT         Control gene sets [${params.scdrs_n_ctrl}]
      --scdrs_filter_data STR     Filter data ("True"/"False") [${params.scdrs_filter_data}]
      --scdrs_raw_count STR      Raw counts ("True"/"False") [${params.scdrs_raw_count}]
      --scdrs_cov_file PATH      Covariate file (TSV: SAMPLE_ID, N_GENE, SEX, AGE) [${params.scdrs_cov_file}]

    Reference Data (hg19 only - hg38 coordinates auto-converted):
      --ref_hg19_plink_prefix PATH Prefix for 1000G PLINK files (hg19) [${params.ref_hg19_plink_prefix}]
      --ref_hg19_baseline PATH     Prefix for baseline v1.1 annotations [${params.ref_hg19_baseline}]
      --ref_hg19_weights PATH      Prefix for LD weights (hm3_noMHC) [${params.ref_hg19_weights}]
      --ref_hg19_hapmap3 PATH      Path to HapMap3 SNP list [${params.ref_hg19_hapmap3}]
      --ref_hg19_gene_coords PATH  Gene coordinates GRCh37 [${params.ref_hg19_gene_coords}]
      --ref_hg19_print_snps PATH   Print SNPs list [${params.ref_hg19_print_snps}]

    Tool Paths:
      --magma_bin PATH           Path to MAGMA binary [${params.magma_bin}]

    Profiles:
      -profile standard          Run locally with Singularity
      -profile pbs               Submit jobs to PBS cluster
      -profile slurm             Submit jobs to SLURM cluster

    Examples:
      # Run full pipeline with hg19 GWAS
      nextflow run main.nf \\
        --h5ad_input data/sc.h5ad \\
        --gwas_sumstats data/gwas.txt.gz \\
        --genome_build hg19 \\
        --gwas_sample_size 455258 \\
        --gene_matrix data/geneMatrix.tsv.gz \\
        --ref_hg19_plink_prefix data/ref/hg19/1000G.EUR.hg19 \\
        --scdrs_cov_file data/covariates.tsv \\
        -profile pbs
      
      # Run with hg38 GWAS (coordinates auto-converted to hg19)
      nextflow run main.nf \\
        --h5ad_input data/sc.h5ad \\
        --gwas_sumstats data/gwas_hg38.txt.gz \\
        --genome_build hg38 \\
        --gwas_sample_size 455258 \\
        --gene_matrix data/geneMatrix.tsv.gz \\
        --ref_hg19_plink_prefix data/ref/hg19/1000G.EUR.hg19 \\
        -profile pbs

    =====================================================
    """.stripIndent()
}

// Show help message if requested
if (params.help) {
    helpMessage()
    exit 0
}
