// nextflow.config

// =====================================================
// Default Parameters
// =====================================================
params {
    // Input/Output - REQUIRED: Must be specified by user
    h5ad_input        = null
    gwas_sumstats     = null
    gwas_name         = null
    outdir            = null  // Recommended format: results/<single-cell-object>/<gwas-name>
    
    // Genome Build - CRITICAL: Must match GWAS genome build
    genome_build      = null  // Options: hg19, GRCh37, hg38, GRCh38
    gwas_sample_size  = null  // Total N for GWAS (required for MAGMA)
    
    // Single-cell parameters
    cell_type_col     = 'cell_type'  // Column name in h5ad.obs with cell type annotations
    
    // Gene coordinates
    gene_matrix       = 'data/reference/geneMatrix.tsv.gz'  // Path to geneMatrix.tsv.gz
    
    // Reference data paths - genome build specific
    // Base reference directory
    ref_base_dir = 'data/reference/eur_w_ld_chr'
    
    // hg19/GRCh37 references
    ref_hg19_plink_dir     = "${ref_base_dir}/hg19/plink"
    ref_hg19_plink_prefix  =  "${ref_hg19_plink_dir}/1000G.EUR.hg19"
    ref_hg19_bim_file      =  "${ref_hg19_plink_dir}/1000G.EUR.hg19.bim"
    ref_hg19_baseline      = "${ref_base_dir}/hg19/baseline/baselineLD."
    ref_hg19_weights       = "${ref_base_dir}/hg19/weights/weights.hm3_noMHC."
    ref_hg19_hapmap3       = "${ref_base_dir}/hg19/hm3_no_MHC.list.txt"
    
    // hg38/GRCh38 references
    ref_hg38_plink_dir     = "${ref_base_dir}/hg38/plink"
    ref_hg38_plink_prefix  = "${ref_hg38_plink_dir}/1000G.EUR.hg38"
    ref_hg38_bim_file      = "${ref_hg38_plink_dir}/1000G.EUR.hg38.bim"
    ref_hg38_baseline      = "${ref_base_dir}/hg38/baseline/baselineLD."
    ref_hg38_weights       = "${ref_base_dir}/hg38/weights/weights.hm3_noMHC."
    ref_hg38_hapmap3       = "${ref_base_dir}/hg38/hm3_no_MHC.list.txt"
    
    // Dynamic selection based on genome_build
    ref_1000g_prefix = (params.genome_build in ['hg38', 'GRCh38']) 
      ? params.ref_hg38_plink_prefix 
      : params.ref_hg19_plink_prefix
    
    // MAGMA options
    magma_bin         = '/scratch/ei56/pa3687/sc-gwas-pipeline/resources/magma'
    run_magma         = true
    magma_window_kb   = 10
    magma_top_pct     = 0.1
    
    // LDSC options
    run_ldsc           = true
    ldsc_window_kb     = 100
    ldsc_ld_wind_cm    = 1
    ldsc_overlap_annot = true
    ldsc_thin_annot    = false
    
    // scDRS options
    run_scdrs              = true
    scdrs_mbat_window_kb   = 50        // Window size in kb for mBAT gene-based test
    scdrs_top_genes        = 1000      // Top genes to include in gene set
    scdrs_n_ctrl           = 1000      // Number of control gene sets for scDRS
    
    // scDRS data processing flags - IMPORTANT: Must be strings "True" or "False"
    // If your h5ad is already filtered/QC'd, set filter_data="False"
    // If your h5ad has raw counts, set raw_count="True", if log-normalized set "False"
    scdrs_filter_data      = "false"   // Filter genes/cells ("True"/"False")
    scdrs_raw_count        = "true"    // Expect raw counts ("True"/"False")
    
    // Help
    help              = false
}

// Environment variables
env {
    SINGULARITY_CACHEDIR="$HOME/.singularity"
    OMP_NUM_THREADS = 1
    NUMBA_CACHE_DIR = "/tmp"
    OPENBLAS_NUM_THREADS = 1
    PYTHONNOUSERSITE     = 1
}

// Process defaults
process {
    cpus          = 1
    memory        = 6.GB
    time          = '4h'
    errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139] ? 'retry' : 'finish' }
    maxRetries    = 2
    cache         = 'lenient'
}

// Define named profiles for different execution environments
profiles {
    standard {
        // Profile for running locally with Singularity
        process.executor     = 'local'
        singularity.enabled  = true
        singularity.autoMounts = true
    }

    pbs {
        // Profile for PBS cluster execution
        includeConfig 'conf/pbs.config'
    }
    
    // Add your custom profiles here as needed
}

// Container engine configuration
singularity {
    enabled    = true
    autoMounts = true
    cacheDir   = "${env.SINGULARITY_CACHEDIR ?: '\$HOME/.singularity'}"
}

// Enable DSL2
nextflow.enable.dsl = 2

// Manifest
manifest {
    name            = 'CATCHY Pipeline'
    author          = 'Peter C Allen'
    homePage        = 'https://github.com/PeterCAllen/CATCHY-pipeline'
    description     = 'Single-cell RNA-seq and GWAS integration pipeline with LDSC, MAGMA and scDRS'
    mainScript      = 'main.nf'
    nextflowVersion = '>=21.04.0'
    version         = '1.0.0'
}

// Function to print help
def helpMessage() {
    log.info"""
    =====================================================
     ${manifest.name} v${manifest.version}
    =====================================================
    Usage:
      nextflow run main.nf --h5ad_input <file> --gwas_sumstats <file> --genome_build <hg19|hg38> --gwas_sample_size <N> [options]

    Required Arguments:
      --h5ad_input PATH          Path to input h5ad file
      --gwas_sumstats PATH       Path to GWAS summary statistics (gzipped)
      --genome_build STR         Genome build (hg19/GRCh37 or hg38/GRCh38)
      --gwas_sample_size INT     Total sample size for GWAS study
      --gene_matrix PATH         Path to geneMatrix.tsv.gz file

    Optional Arguments:
      --cell_type_col STR        Column in h5ad.obs with cell types [${params.cell_type_col}]
      --outdir PATH              Output directory [${params.outdir}]
      --ldsc_window_kb INT       Window size (kb) for LDSC [${params.ldsc_window_kb}]
      --magma_window_kb INT      Window size (kb) for MAGMA [${params.magma_window_kb}]
      --run_ldsc BOOL            Run LDSC analysis [${params.run_ldsc}]
      --run_magma BOOL           Run MAGMA analysis [${params.run_magma}]
      --run_scdrs BOOL           Run scDRS analysis [${params.run_scdrs}]
      
    scDRS Options (when --run_scdrs true):
      --scdrs_mbat_window_kb INT mBAT window size in kb [${params.scdrs_mbat_window_kb}]
      --scdrs_top_genes INT      Top genes for gene set [${params.scdrs_top_genes}]
      --scdrs_n_ctrl INT         Control gene sets [${params.scdrs_n_ctrl}]
      --scdrs_filter_data STR     Filter data ("True"/"False") [${params.scdrs_filter_data}]
      --scdrs_raw_count STR      Raw counts ("True"/"False") [${params.scdrs_raw_count}]

    Reference Data (required):
      --ref_1000g_prefix PATH     Prefix for 1000G PLINK files
      --ldsc_baseline_prefix PATH Prefix for baseline LD annotations
      --ldsc_weights_prefix PATH  Prefix for LD weights
      --hapmap3_snplist PATH     Path to HapMap3 SNP list

    Tool Paths:
      --magma_bin PATH           Path to MAGMA binary [${params.magma_bin}]

    Profiles:
      -profile standard          Run locally with Singularity
      -profile pbs               Submit jobs to PBS cluster

    Examples:
      # Run full pipeline with hg19 GWAS
      nextflow run main.nf \\
        --h5ad_input data/sc.h5ad \\
        --gwas_sumstats data/gwas.txt.gz \\
        --genome_build hg19 \\
        --gwas_sample_size 455258 \\
        --gene_matrix data/geneMatrix.tsv.gz \\
        --ref_1000g_prefix data/ref/1000G.EUR.QC \\
        --ldsc_baseline_prefix data/ref/baselineLD. \\
        --ldsc_weights_prefix data/ref/weights.hm3_noMHC. \\
        --hapmap3_snplist data/ref/hm3_no_MHC.list.txt \\
        -profile pbs

    =====================================================
    """.stripIndent()
}

// Show help message if requested
if (params.help) {
    helpMessage()
    exit 0
}
