// nextflow.config

// =====================================================
// Default Parameters
// =====================================================
params {
    // Input/Output - REQUIRED: Must be specified by user
    h5ad_input        = 'data/singlecell/Human_fetal_BM10x_preprocessed.h5ad'

    // GWAS summary statistics. Provide --gwas_sumstats (a single raw file the pipeline
    // will reformat itself for each branch), or, if you already have pre-formatted
    // files, skip the corresponding reformatting step directly:
    //   --gwas_cojo             GCTA-COJO .ma (SNP A1 A2 freq b se p N) -> bypasses
    //                           FORMAT_GWAS_FOR_MBAT for the seismic/scDRS branch
    //   --gwas_sumstats_munged  pre-munged LDSC .sumstats.gz -> bypasses
    //                           CONVERT_GWAS_FOR_LDSC + MUNGE_SUMSTATS for conLDSC
    // At least one of --gwas_sumstats / --gwas_cojo / --gwas_sumstats_munged is required.
    gwas_sumstats         = null
    gwas_cojo             = null
    gwas_sumstats_munged  = null

    gwas_name         = 'AD_Jansen2019'  // Short name for GWAS
    outdir            = 'results/Human_fetal_BM10x/AD_Jansen2019'  // Recommended format: results/<single-cell-object>/<gwas-name>

    // Genome Build - CRITICAL: Must match GWAS genome build
    genome_build      = 'hg19'  // Options: hg19, GRCh37, hg38, GRCh38
    gwas_sample_size  = 381761  // Total N for GWAS (required for MAGMA)
    
    // Single-cell parameters
    cell_type_col     = 'cell.labels'  // Column name in h5ad.obs with cell type annotations

    // Gene coordinates
    gene_matrix       = 'data/reference/geneMatrix.tsv.gz'  // Path to geneMatrix.tsv.gz

    // Preprocessing (Li et al. Methods: log2(TPM+1), protein-coding, >=20 cells per cell type)
    protein_coding_only    = true
    min_cells_per_celltype = 20
    h5ad_input_scale       = 'auto'   // auto | raw_counts | lognorm
    h5ad_log_base          = 'e'      // base of any prior log normalization: e | 2
    h5ad_use_raw           = false    // promote adata.raw to X before normalizing

    // Reference data paths - ALWAYS use hg19/GRCh37
    // (Gene coordinates are automatically converted from hg38 when needed)
    // Base reference directory - Using collaborators' exact reference files
    ref_base_dir = 'data/reference/LDSC_relevant_for_Peter'
    
    // hg19/GRCh37 references (used for MAGMA, LDSC, and scDRS mBAT)
    ref_hg19_plink_dir        = "${params.ref_base_dir}/1000G_EUR_Phase3_plink"
    ref_hg19_plink_prefix     = "${params.ref_hg19_plink_dir}/1000G.EUR.QC"           // Per-chromosome: 1000G.EUR.QC.{1-22}.{bed,bim,fam} (for LDSC)
    ref_hg19_plink_combined   = "${params.ref_hg19_plink_dir}/1000G.EUR.QC.CHR_1_22"  // Combined all chr: 1000G.EUR.QC.CHR_1_22.{bed,bim,fam} (for MAGMA)
    ref_hg19_bim_file         = "${params.ref_hg19_plink_dir}/1000G.EUR.QC.CHR_1_22.bim"
    ref_hg19_baseline      = "${params.ref_base_dir}/baseline_v1.1_thin_annot/baseline."
    ref_hg19_weights       = "${params.ref_base_dir}/1000G_Phase3_weights_hm3_no_MHC/weights.hm3_noMHC."
    ref_hg19_hapmap3       = "data/reference/eur_w_ld_chr/hg19/hm3_no_MHC.list.txt"  // One-column rsID list required by LDSC --print-snps
    ref_hg19_gene_coords   = "${params.ref_base_dir}/gene_coordinates.GRCh37.ensembl_v91.txt"
    ref_hg19_print_snps    = "${params.ref_base_dir}/print_snps.txt"
    ref_hg19_frq_dir       = "${params.ref_base_dir}/1000G_Phase3_frq"
    ref_hg19_chr_sizes     = "${params.ref_base_dir}/GRCh37-chr-sizes.txt"   // 2 cols, chr 1-22, hg19 lengths
    ref_hg19_w_hm3_snplist = "${params.ref_base_dir}/w_hm3.snplist"          // munge_sumstats.py --merge-alleles

    // For backward compatibility (but always points to hg19)
    ref_1000g_prefix = params.ref_hg19_plink_prefix

    // Specificity metrics
    run_cepo             = true
    run_cellex           = false  // optional validation branch (conLDSC-GES), not part of CATCH
    cepo_compute_pvalue  = 100
    cepo_prefilter_pzero = 0.4

    // conLDSC (CELLECT-LDSC)
    run_conldsc          = true
    conldsc_cepo_variant = 'cepo_norm'   // cepo_norm | cepo_s
    conldsc_window_kb    = 100
    conldsc_ld_wind_cm   = 1
    conldsc_top_pct      = null          // null = full ES matrix (CELLECT default); e.g. 0.10 for the top decile
    conldsc_keep_annots  = false         // also write the full SNP:ES + gene-list annot files

    // mBAT-combo (shared by seismic and scDRS)
    mbat_window_kb         = 10

    // seismic (optional validation branch, not part of CATCH)
    run_seismic            = false
    seismic_assay          = 'logcounts'
    seismic_lognorm        = false     // run scater::logNormCounts before calc_specificity

    // scDRS options
    run_scdrs              = true
    scdrs_top_genes        = 1000      // Top genes to include in gene set
    scdrs_n_ctrl           = 1000      // Number of control gene sets for scDRS

    // scDRS data processing flags - IMPORTANT: Must be strings "True" or "False"
    // Collaborators consistently use True for both parameters
    // If your h5ad is already filtered/QC'd, set filter_data="False"
    // If your h5ad has raw counts, set raw_count="True", if log-normalized set "False"
    scdrs_filter_data      = "False"   // Filter genes/cells ("True"/"False")
    scdrs_raw_count        = "False"   // NORMALIZE_H5AD emits log2(TPM+1), so this must be False

    // scDRS covariate file (optional)
    // TSV file with columns: SAMPLE_ID, N_GENE, SEX, AGE
    // Used to control for technical and biological covariates in scDRS analysis
    scdrs_cov_file         = "data/singlecell/Human_fetal_BM10x_covariates.txt"      // Path to covariate file (optional)

    // Legacy, not part of the CATCH combination (see modules/legacy/README.md)
    run_magma          = false
    magma_bin          = 'resources/magma'
    magma_window_kb    = 10
    magma_top_pct      = 0.1
    ldsc_window_kb     = 100
    ldsc_ld_wind_cm    = 1
    ldsc_thin_annot    = true
    enable_conda       = false

    // Singularity image cache
    singularity_cachedir = System.getenv('SINGULARITY_CACHEDIR') ?: "${System.getenv('HOME')}/.singularity"

    // Help
    help              = false
}

// Environment variables
env {
    SINGULARITY_CACHEDIR = params.singularity_cachedir
    OMP_NUM_THREADS = 1
    NUMBA_CACHE_DIR = "/tmp"
    OPENBLAS_NUM_THREADS = 1
    PYTHONNOUSERSITE     = 1
}

// Process defaults
process {
    cpus          = 1
    memory        = 6.GB
    time          = '4h'
    errorStrategy = { task.exitStatus in [143, 137, 104, 134, 139] ? 'retry' : 'finish' }
    maxRetries    = 2
    cache         = 'lenient'
}

// Execution reporting -- always on so every run (including manuscript benchmarking
// runs) records the compute-hours/memory data needed for methods reporting.
def trace_timestamp = new java.text.SimpleDateFormat("yyyyMMdd_HHmmss").format(new java.util.Date())

trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_trace_${trace_timestamp}.txt"
    overwrite = true
    fields    = 'task_id,hash,native_id,process,tag,status,exit,submit,duration,realtime,%cpu,cpus,memory,%mem,rss,peak_rss,rchar,wchar'
}

report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_report_${trace_timestamp}.html"
    overwrite = true
}

timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/execution_timeline_${trace_timestamp}.html"
    overwrite = true
}

// Define named profiles for different execution environments
profiles {
    standard {
        // Profile for running locally with Singularity
        process.executor     = 'local'
        singularity.enabled  = true
        singularity.autoMounts = true
    }

    pbs {
        // Profile for PBS cluster execution
        includeConfig 'conf/pbs.config'
    }
    
    // Add your custom profiles here as needed
}

// Container engine configuration
singularity {
    enabled    = true
    autoMounts = true
    cacheDir   = params.singularity_cachedir
}

// Completion summary
workflow {
    onComplete = {
        println """
    =====================================================
     Pipeline completed at: ${workflow.complete}
     Execution status: ${workflow.success ? 'SUCCESS' : 'FAILED'}
     Duration: ${workflow.duration}
     Results: ${params.outdir}
    =====================================================
    """.stripIndent()
    }
}

// Enable DSL2
nextflow.enable.dsl = 2

// Manifest
manifest {
    name            = 'CATCH Pipeline'
    author          = ' '
    homePage        = ' '
    description     = 'CATCH: Cauchy combination of conLDSC-Cepo and scDRS (mBAT-combo based)'
    mainScript      = 'main.nf'
    nextflowVersion = '>=21.04.0'
    version         = '2.0.0'
}
